# -------------------------------------------------------------------------
# -------------------------------------------------------------------------
# Adds a prefix to existing attributes. This is done to ensure we don't
# overwrite any attributes when we add new ones.
Tcl2 proc RasterExtentsCoercer_prefixExistingAttributes {attrNames} {    set kAttrPrefix ".";    foreach oldName $attrNames {       set newName $kAttrPrefix;       append newName $oldName;       FME_RenameAttribute $newName $oldName;    }; };
# -------------------------------------------------------------------------
# Restores all previously prefixed attributes.
# This list of removed attributes should be kept in sync with those created
# by `@RasterProperties(RASTER)` and `@ProcessRasterTiles(DATAEXTENTS)`.
Tcl2 proc RasterExtentsCoercer_restorePrefixedAttributes {attrNames} {    FME_Execute RemoveAttributes _cell_origin_x _cell_origin_y _data_max_column _data_max_row _data_min_column _data_min_row _lower_left_x _lower_left_y _lower_right_x _lower_right_y _max_x _max_y _min_x _min_y _num_bands _num_columns _num_rows _origin_x _origin_y _rotation _spacing_x _spacing_y _upper_left_x _upper_left_y _upper_right_x _upper_right_y;    set kAttrPrefix ".";    foreach oldName $attrNames {       set newName $kAttrPrefix;       append newName $oldName;       FME_RenameAttribute $oldName $newName;    }; };
# -------------------------------------------------------------------------
# Replaces the existing geometry on a feature with a polygon.
Tcl2 proc RasterExtentsCoercer_replaceGeometryWithPolygon {ulx uly urx ury lrx lry llx lly} {    set comment {       Remove the existing geometry.    };    FME_Execute RemoveGeometry;    set comment {       Create the polygon.    };    FME_Coordinates addCoord $ulx $uly;    FME_Coordinates addCoord $urx $ury;    FME_Coordinates addCoord $lrx $lry;    FME_Coordinates addCoord $llx $lly;    FME_Coordinates addCoord $ulx $uly;    FME_Execute GeometryType fme_polygon;    FME_SetAttribute fme_type fme_area; };
# -------------------------------------------------------------------------
# Replaces the raster geometry with a polygon, using the rotated corners
# of the raster.
Tcl2 proc RasterExtentsCoercer_getRasterExtents {} {    set comment {       Retrieve the rotated extents.    };    set attrNames [FME_AttributeNames];    FME_Execute RenameAttributes FME_STRICT ___fme_rejection_code___ fme_rejection_code;    RasterExtentsCoercer_prefixExistingAttributes $attrNames;    FME_Execute RasterProperties REJECTABLE RASTER;    if {[string length [FME_GetAttribute {fme_rejection_code}]] == 0} {       set ulx [FME_GetAttribute _upper_left_x];       set uly [FME_GetAttribute _upper_left_y];       set urx [FME_GetAttribute _upper_right_x];       set ury [FME_GetAttribute _upper_right_y];       set lrx [FME_GetAttribute _lower_right_x];       set lry [FME_GetAttribute _lower_right_y];       set llx [FME_GetAttribute _lower_left_x];       set lly [FME_GetAttribute _lower_left_y];       set comment {          Create the extents polygon.       };       RasterExtentsCoercer_restorePrefixedAttributes $attrNames;       RasterExtentsCoercer_replaceGeometryWithPolygon $ulx $uly $urx $ury $lrx $lry $llx $lly;    } else {       RasterExtentsCoercer_restorePrefixedAttributes $attrNames;    } };
# -------------------------------------------------------------------------
# Replaces the raster geometry with a polygon, using the MBR extents of
# the data in the raster.
Tcl2 proc RasterExtentsCoercer_getDataMBRExtents {} {    set comment {       Get the raster properties and calculate the row/col data extents.    };    set attrNames [FME_AttributeNames];    FME_Execute RenameAttributes FME_STRICT ___fme_rejection_code___ fme_rejection_code;    RasterExtentsCoercer_prefixExistingAttributes $attrNames;    FME_Execute RasterProperties REJECTABLE RASTER;    FME_Execute ProcessRasterTiles REJECTABLE DATAEXTENTS;    if {[string length [FME_GetAttribute {fme_rejection_code}]] == 0} {       set originX [FME_GetAttribute _origin_x];       set originY [FME_GetAttribute _origin_y];       set spacingX [FME_GetAttribute _spacing_x];       set spacingY [FME_GetAttribute _spacing_y];       set minRow [FME_GetAttribute _data_min_row];       set minCol [FME_GetAttribute _data_min_column];       set maxRow [FME_GetAttribute _data_max_row];       set maxCol [FME_GetAttribute _data_max_column];       RasterExtentsCoercer_restorePrefixedAttributes $attrNames;       set comment {          Calculate the extents in ground coordinates.       };       set minX [expr $originX + ($minCol*$spacingX)];       set maxX [expr $originX + (($maxCol+1)*$spacingX)];       set minY [expr $originY - (($maxRow+1)*$spacingY)];       set maxY [expr $originY - ($minRow*$spacingY)];       set comment {          Create the extents polygon.       };       RasterExtentsCoercer_replaceGeometryWithPolygon $minX $maxY $maxX $maxY $maxX $minY $minX $minY;    } else {       RasterExtentsCoercer_restorePrefixedAttributes $attrNames;    } };
INCLUDE [ if {{RasterExtents} == {RasterExtents}} {    puts {       FACTORY_DEF {*} TeeFactory          FACTORY_NAME { RasterExtentsCoercer_RasterExtents }          INPUT  FEATURE_TYPE AttributeCreator_OUTPUT          OUTPUT { FEATURE_TYPE ___TOREJECTOR___             @RenameAttributes(FME_STRICT,___fme_rejection_code___,fme_rejection_code)             @Tcl2("RasterExtentsCoercer_getRasterExtents") }    };    puts {       FACTORY_DEF {*} TestFactory          FACTORY_NAME { RasterExtentsCoercer_Rejector }          INPUT FEATURE_TYPE ___TOREJECTOR___          TEST @Value(fme_rejection_code) != ""          OUTPUT { PASSED FEATURE_TYPE RasterExtentsCoercer_<REJECTED>             @RemoveAttributes(___fme_rejection_code___)              }          OUTPUT { FAILED FEATURE_TYPE RasterExtentsCoercer_EXTENTS             @RenameAttributes(FME_STRICT,fme_rejection_code,___fme_rejection_code___)              }    }; } elseif {{RasterExtents} == {DataMBRExtents}} {    puts {       FACTORY_DEF {*} TeeFactory          FACTORY_NAME { RasterExtentsCoercer_DataMBRExtents }          INPUT  FEATURE_TYPE AttributeCreator_OUTPUT          OUTPUT FEATURE_TYPE ___TOREJECTOR___             @RenameAttributes(FME_STRICT,___fme_rejection_code___,fme_rejection_code)             @ApplyRasterRotation(REJECTABLE,NEARESTNEIGHBOR)             @Tcl2("RasterExtentsCoercer_getDataMBRExtents")    };    puts {       FACTORY_DEF {*} TestFactory          FACTORY_NAME { RasterExtentsCoercer_Rejector }          INPUT FEATURE_TYPE ___TOREJECTOR___          TEST @Value(fme_rejection_code) != ""          OUTPUT { PASSED FEATURE_TYPE RasterExtentsCoercer_<REJECTED>             @RemoveAttributes(___fme_rejection_code___)              }          OUTPUT { FAILED FEATURE_TYPE RasterExtentsCoercer_EXTENTS             @RenameAttributes(FME_STRICT,fme_rejection_code,___fme_rejection_code___)              }    }; } else {    puts {       FACTORY_DEF {*} TeeFactory          FACTORY_NAME { RasterExtentsCoercer_RasterIDGenerator }          INPUT  FEATURE_TYPE AttributeCreator_OUTPUT          OUTPUT { FEATURE_TYPE RasterExtentsCoercer_rasters_with_IDs             @SupplyAttributes(__rasterID__, @Count(RasterExtentsCoercer_COUNTER)) }    };    puts {       FACTORY_DEF {*} RasterSegmentationFactory          FACTORY_NAME { RasterExtentsCoercer_PolygonGenerator }          INPUT { FEATURE_TYPE RasterExtentsCoercer_rasters_with_IDs }          POLYGON_MODE NODATA          PRESERVE_ATTRIBUTES yes          REJECT_INVALID_FEATURES YES          POLYGON_LABEL_ATTRIBUTE __polygon_type__          OUTPUT { POLYGONS FEATURE_TYPE RasterExtentsCoercer_polygons }          OUTPUT { <REJECTED> FEATURE_TYPE RasterExtentsCoercer_<REJECTED>              }    };    puts {       FACTORY_DEF {*} TestFactory          FACTORY_NAME { RasterExtentsCoercer_NodataPolygonDiscarder }          INPUT { FEATURE_TYPE RasterExtentsCoercer_polygons }          TEST &__polygon_type__ == "data"          OUTPUT { PASSED FEATURE_TYPE RasterExtentsCoercer_data_polygons             @RemoveAttributes(__polygon_type__) }    };    puts {       FACTORY_DEF {*} AggregateFactory          FACTORY_NAME { RasterExtentsCoercer_DataPolygonAggregator }          INPUT { FEATURE_TYPE RasterExtentsCoercer_data_polygons }          GROUP_BY __rasterID__          BREAK_BEFORE_FIELD_CHANGE __rasterID__          ACCUMULATE_ATTRIBUTES yes          OUTPUT { AGGREGATE FEATURE_TYPE RasterExtentsCoercer_EXTENTS             @RemoveAttributes(__rasterID__)              }          OUTPUT { SINGLETON FEATURE_TYPE RasterExtentsCoercer_EXTENTS             @RemoveAttributes(__rasterID__)              }    }; }; ]
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME RasterExtentsCoercer_<Rejected> INPUT FEATURE_TYPE RasterExtentsCoercer_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, RasterExtentsCoercer<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory FACTORY_NAME "Destination Feature Type Routing Correlator"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE FME_GENERIC RasterExtentsCoercer_EXTENTS TO GEODATABASE_FILE __GO_TO_FINAL_OUTPUT_ROUTER__ multi_writer_id,0,<at>SupplyAttributes<openparen>ENCODED<comma>__wb_out_feat_type__<comma>Extents<closeparen> GEOMETRY   FEATURE_TYPE_ATTRIBUTE __wb_out_feat_type__   OUTPUT ROUTED FEATURE_TYPE *    OUTPUT NOT_ROUTED FEATURE_TYPE __nuke_me__ @Tcl2("FME_StatMessage 818059 [FME_GetAttribute fme_template_feature_type] 818060 818061 fme_warn")
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory   FACTORY_NAME "Final Output Nuker"   INPUT FEATURE_TYPE __nuke_me__

