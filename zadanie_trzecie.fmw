# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "scotland_and_wales_region_OGCGEOPACKAGE_1 Splitter"    INPUT FEATURE_TYPE scotland_and_wales_region    OUTPUT FEATURE_TYPE scotland_and_wales_region_OGCGEOPACKAGE_1
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { RasterPaletteRemover }    INPUT  FEATURE_TYPE GEOTIFF_GEOTIFF_2    FUNCTION_DEFINITION { @RemoveRasterPalettes(REJECTABLE) }    OUTPUT { COMPLETE FEATURE_TYPE RasterPaletteRemover_OUTPUT        }    OUTPUT { REJECTED FEATURE_TYPE RasterPaletteRemover_<REJECTED>        }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME RasterPaletteRemover_<Rejected> INPUT FEATURE_TYPE RasterPaletteRemover_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, RasterPaletteRemover<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester }    INPUT  FEATURE_TYPE scotland_and_wales_region_OGCGEOPACKAGE_1    CASE_INSENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>File_Name<closeparen>,Tester)" CONTAINS SOUTH_WALES ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_PASSED         }
