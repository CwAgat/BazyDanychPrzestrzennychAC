FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE OGCGEOPACKAGE OGCGEOPACKAGE_1::scotland_and_wales_region multi_reader_keyword,$(DATASET_KEYWORD_OGCGEOPACKAGE_1) TO FME_GENERIC ::scotland_and_wales_region ALIAS_GEOMETRY    ROUTE GEOTIFF GEOTIFF_2::GEOTIFF multi_reader_keyword,$(DATASET_KEYWORD_GEOTIFF_2) TO FME_GENERIC ::GEOTIFF ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
OGCGEOPACKAGE_1_MERGE_DEF OGCGEOPACKAGE_1::scotland_and_wales_region EXACT scotland_and_wales_region DEFLINE geopackage_type,geopackage_multipolygon<space>geopackage_polygon,geopackage_where_clause,,fme_attribute_reading,defined,Name,text<openparen>100<closeparen>,Area_Code,text<openparen>3<closeparen>,Area_Description,text<openparen>50<closeparen>,File_Name,text<openparen>100<closeparen>,Feature_Serial_Number,mediumint,Collection_Serial_Number,mediumint,Global_Polygon_ID,mediumint,Admin_Unit_ID,mediumint,Census_Code,text<openparen>9<closeparen>,Hectares,double,Non_Inland_Area,double,Area_Type_Code,text<openparen>2<closeparen>,Area_Type_Description,text<openparen>25<closeparen>,Non_Area_Type_Code,text<openparen>3<closeparen>,Non_Area_Type_Description,text<openparen>36<closeparen>,fid,int<comma>PrimaryKey
